# ====================================================================
# SIMASJID - TEMPLATE VARIABEL LINGKUNGAN (env.example)
# Terintegrasi dengan Supabase PostgreSQL & Gemini AI
# ====================================================================

# 1. SUPABASE DATABASE REALTIME CONFIGURATION
# Dapatkan URL & Anon Key dari Dashboard Supabase: Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# 2. GEMINI AI API KEY (ASISTEN AI TAKMIR)
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. APP HOSTING URL
APP_URL="http://localhost:3000"
